# Copy to .env and fill in. NEVER commit .env.

# --- Backend ---
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# --- Database (Member 2) ---
# Matches docker-compose.yml defaults.
DATABASE_URL=postgresql+psycopg://fintwin:fintwin@localhost:5432/fintwin

# --- LLM / Agent (Member 4) ---
# Get a key from https://console.anthropic.com
# Leave it empty and the agent still works, using its deterministic keyword router.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_EFFORT=medium
AGENT_USE_LLM=true

# --- Market data (Member 2) ---
MARKET_DATA_PROVIDER=yfinance
MARKET_DATA_API_KEY=

# --- Simulation (Member 5) ---
# Fixed seed keeps benchmark runs reproducible. Do not change casually.
SIMULATION_SEED=42
SIMULATION_DEFAULT_PATHS=10000

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
